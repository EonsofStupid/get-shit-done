{
  "vp": {
    "gradient": {
      "brand-primary": {
        "$type": "gradient",
        "$value": [
          { "color": "#7c3aed", "position": 0 },
          { "color": "#ec4899", "position": 1 }
        ],
        "$description": "Primary brand gradient — purple to pink",
        "$extensions": {
          "com.vibepulse.styleId": "gradient-brand-primary",
          "com.vibepulse.cssValue": "linear-gradient(135deg, #7c3aed, #ec4899)"
        }
      },
      "brand-accent": {
        "$type": "gradient",
        "$value": [
          { "color": "#ec4899", "position": 0 },
          { "color": "#f59e0b", "position": 1 }
        ],
        "$description": "Accent gradient — pink to amber",
        "$extensions": {
          "com.vibepulse.styleId": "gradient-brand-accent",
          "com.vibepulse.cssValue": "linear-gradient(135deg, #ec4899, #f59e0b)"
        }
      },
      "surface-dark": {
        "$type": "gradient",
        "$value": [
          { "color": "#0f172a", "position": 0 },
          { "color": "#1e293b", "position": 1 }
        ],
        "$description": "Dark surface gradient",
        "$extensions": {
          "com.vibepulse.styleId": "gradient-surface-dark",
